<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.6" prefHeight="640.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="su.nepom.budget.desktop.ui.transaction.TransactionController">
   <items>
      <VBox spacing="5.0">
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <children>
            <GridPane hgap="5.0" vgap="5.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="NEVER" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" />
                  <ColumnConstraints hgrow="NEVER" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints vgrow="NEVER" />
                  <RowConstraints vgrow="NEVER" />
                  <RowConstraints vgrow="NEVER" />
               </rowConstraints>
               <children>
                  <Label text="Период" />
                  <ComboBox fx:id="dateRangeComboBox" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" />
                  <HBox fx:id="customDateBox" alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="2" GridPane.columnSpan="2">
                     <children>
                        <Label text="с" />
                        <DatePicker fx:id="fromDatePicker" prefWidth="130.0" />
                        <Label text="по" />
                        <DatePicker fx:id="toDatePicker" prefWidth="130.0" />
                     </children>
                  </HBox>
                  <Label text="Счета" GridPane.rowIndex="1" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1">
                     <children>
                        <Button fx:id="pickAccountsButton" mnemonicParsing="false" text="Выбрать..." />
                        <Label fx:id="accountsSummaryLabel" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <Label text="Описание" GridPane.rowIndex="2" />
                  <TextField fx:id="descriptionFilterField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Флаг" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <ComboBox fx:id="flagComboBox" maxWidth="1.7976931348623157E308" GridPane.columnIndex="3" GridPane.rowIndex="2" />
               </children>
            </GridPane>
            <HBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label text="Показывать" />
                  <ComboBox fx:id="deletedComboBox" prefWidth="130.0" />
                  <Label text="Сортировка" />
                  <ComboBox fx:id="sortComboBox" prefWidth="150.0" />
                  <Button fx:id="resetFilterButton" mnemonicParsing="false" text="Сбросить" />
                  <Button fx:id="applyFilterButton" mnemonicParsing="false" text="Применить" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Button fx:id="prevPageButton" mnemonicParsing="false" text="◀" />
                  <Label text="Стр." />
                  <TextField fx:id="pageField" prefWidth="60.0" />
                  <Label fx:id="pageLabel" />
                  <Button fx:id="nextPageButton" mnemonicParsing="false" text="▶" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="newButton" mnemonicParsing="false" style="-fx-font-weight: bold;" text="Создать" />
               </children>
            </HBox>
            <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="dateColumn" editable="false" prefWidth="130.0" text="Дата" />
                <TableColumn fx:id="descriptionColumn" editable="false" prefWidth="220.0" text="Описание" />
                <TableColumn fx:id="accountsColumn" editable="false" prefWidth="200.0" text="Счета" />
                <TableColumn fx:id="amountColumn" editable="false" prefWidth="140.0" text="Сумма" />
                <TableColumn fx:id="flagColumn" editable="false" prefWidth="60.0" text="Флаг" />
                <TableColumn fx:id="deletedColumn" editable="false" prefWidth="70.0" text="Удалена" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <VBox spacing="5.0">
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <children>
            <GridPane hgap="5.0" vgap="5.0">
               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="80.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints vgrow="NEVER" />
                  <RowConstraints vgrow="NEVER" />
                  <RowConstraints vgrow="NEVER" />
                  <RowConstraints vgrow="NEVER" />
                  <RowConstraints vgrow="NEVER" />
               </rowConstraints>
               <children>
                  <Label text="id" />
                  <TextField fx:id="idTextField" GridPane.columnIndex="1" />
                  <Label text="Дата" GridPane.rowIndex="1" />
                  <DatePicker fx:id="dateEditPicker" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Описание" GridPane.rowIndex="2" />
                  <TextField fx:id="descriptionEditField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <HBox spacing="15.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <CheckBox fx:id="flagCheckbox" mnemonicParsing="false" text="Флаг" />
                        <CheckBox fx:id="deletedCheckbox" mnemonicParsing="false" text="Удалена" />
                     </children>
                  </HBox>
                  <Label text="Изменено" GridPane.rowIndex="4" />
                  <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                     <children>
                        <TextField fx:id="changedAtField" editable="false" prefWidth="120.0" />
                        <Label text="Автор" />
                        <TextField fx:id="creatorField" editable="false" prefWidth="100.0" HBox.hgrow="ALWAYS" />
                        <Label text="Место" />
                        <TextField fx:id="placeField" editable="false" prefWidth="90.0" />
                     </children>
                  </HBox>
               </children>
            </GridPane>
            <Label text="Строки (двойной клик по счёту - выбор)" />
            <VBox fx:id="itemsEditorBox" spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="itemAccountColumn" prefWidth="160.0" text="Счёт" />
                      <TableColumn fx:id="itemCurrencyColumn" editable="false" prefWidth="70.0" text="Валюта" />
                      <TableColumn fx:id="itemKindColumn" editable="false" prefWidth="70.0" text="Тип" />
                      <TableColumn fx:id="itemAmountColumn" prefWidth="110.0" text="Сумма" />
                      <TableColumn fx:id="itemBalanceColumn" editable="false" prefWidth="110.0" text="Остаток счёта" />
                      <TableColumn fx:id="itemDescriptionColumn" prefWidth="200.0" text="Описание" />
                      <TableColumn fx:id="itemFlagColumn" prefWidth="60.0" text="Флаг" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox spacing="5.0">
                     <children>
                        <Button fx:id="addItemButton" mnemonicParsing="false" text="Добавить строку" />
                        <Button fx:id="removeItemButton" mnemonicParsing="false" text="Удалить строку" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Label fx:id="balanceLabel" wrapText="true" />
            <ButtonBar>
              <buttons>
                <Button fx:id="okButton" mnemonicParsing="false" text="Сохранить" />
                <Button fx:id="copyButton" mnemonicParsing="false" prefHeight="26.0" prefWidth="210.0" text="Скопировать" />
                <Button fx:id="cancelButton" mnemonicParsing="false" text="Отмена" />
              </buttons>
            </ButtonBar>
         </children>
      </VBox>
   </items>
</SplitPane>
