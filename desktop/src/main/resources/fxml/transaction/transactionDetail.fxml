<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import org.controlsfx.control.SearchableComboBox?>

<!-- StackPane so focusRingOverlay can be drawn free-floating on top of the form, positioned by
     TransactionDetailController to match whatever field currently has focus - AtlantaFX's own
     :focused styling for SearchableComboBox/CheckBox does not repaint immediately on Tab, only
     later once the control is interacted with, so this draws an independent ring instead. -->
<StackPane fx:id="root" styleClass="transaction-detail-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="su.nepom.budget.desktop.ui.transaction.TransactionDetailController">
   <stylesheets>
      <URL value="@transactionDetail.css" />
   </stylesheets>
   <children>
      <VBox spacing="5.0">
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <children>
      <!-- no visible checkbox - the footer "Удалить операцию" / "Восстановить операцию" button
           drives this field instead; the node stays detached for FormDriver's field wiring -->
      <CheckBox fx:id="deletedCheckbox" mnemonicParsing="false" text="Удалена" visible="false" managed="false" />
      <VBox fx:id="itemsEditorBox" spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox fx:id="viewModeBox" alignment="CENTER_LEFT" spacing="0.0">
               <children>
                  <ToggleButton fx:id="viewModeNormalButton" mnemonicParsing="false" selected="true" styleClass="left-pill, view-mode-toggle" text="Обычная операция" />
                  <ToggleButton fx:id="viewModeEntriesButton" mnemonicParsing="false" styleClass="right-pill, view-mode-toggle" text="Проводки" />
                  <ToggleButton fx:id="allowEditToggle" mnemonicParsing="false" styleClass="allow-edit-toggle" text="Редактирование запрещено, разрешить">
                     <HBox.margin>
                        <Insets left="32.0" />
                     </HBox.margin>
                  </ToggleButton>
               </children>
            </HBox>
            <Separator>
               <VBox.margin>
                  <Insets bottom="8.0" top="8.0" />
               </VBox.margin>
            </Separator>
            <HBox fx:id="typeSwitchBox" spacing="0.0">
               <children>
                  <ToggleButton fx:id="typeIncomeButton" mnemonicParsing="false" styleClass="left-pill" text="Приход" />
                  <ToggleButton fx:id="typeExpenseButton" mnemonicParsing="false" selected="true" styleClass="center-pill" text="Расход" />
                  <ToggleButton fx:id="typeTransferButton" mnemonicParsing="false" styleClass="center-pill" text="Перевод" />
                  <ToggleButton fx:id="typeExchangeButton" mnemonicParsing="false" styleClass="center-pill" text="Обмен" />
                  <ToggleButton fx:id="typeCurrencyTransferButton" mnemonicParsing="false" styleClass="right-pill" text="Перевод валюты" />
               </children>
            </HBox>
