<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" spacing="5.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="su.nepom.budget.desktop.ui.transaction.TransactionDetailController">
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <children>
      <GridPane hgap="5.0" vgap="5.0">
         <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="80.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints vgrow="NEVER" />
            <RowConstraints vgrow="NEVER" />
            <RowConstraints vgrow="NEVER" />
            <RowConstraints vgrow="NEVER" />
            <RowConstraints vgrow="NEVER" />
         </rowConstraints>
         <children>
            <Label text="id" />
            <TextField fx:id="idTextField" GridPane.columnIndex="1" />
            <Label text="Дата" GridPane.rowIndex="1" />
            <DatePicker fx:id="dateEditPicker" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Описание" GridPane.rowIndex="2" />
            <TextField fx:id="descriptionEditField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <HBox spacing="15.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
               <children>
                  <CheckBox fx:id="flagCheckbox" mnemonicParsing="false" text="Флаг" />
                  <CheckBox fx:id="deletedCheckbox" mnemonicParsing="false" text="Удалена" />
               </children>
            </HBox>
            <Label fx:id="eventInfoLabel" text="Изменено" GridPane.rowIndex="4" />
            <HBox fx:id="eventInfoBox" alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
               <children>
                  <TextField fx:id="changedAtField" editable="false" prefWidth="120.0" />
                  <Label text="Автор" />
                  <TextField fx:id="creatorField" editable="false" prefWidth="100.0" HBox.hgrow="ALWAYS" />
                  <Label text="Где" />
                  <TextField fx:id="placeField" editable="false" prefWidth="90.0" />
               </children>
            </HBox>
         </children>
      </GridPane>
      <VBox fx:id="itemsEditorBox" spacing="5.0" VBox.vgrow="ALWAYS">
         <children>
            <TabPane fx:id="operationTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>
                  <Tab fx:id="incomeTab" text="Приход">
                     <content>
                        <GridPane hgap="5.0" vgap="5.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="80.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                           </rowConstraints>
                           <children>
                              <Label text="Деньги" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1">
                                 <children>
                                    <Button fx:id="incomeMoneyButton" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="incomeMoneyClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="incomeMoneyLabel" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="Бюджет" GridPane.rowIndex="1" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <Button fx:id="incomeBudgetButton" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="incomeBudgetClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="incomeBudgetLabel" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="Сумма" GridPane.rowIndex="2" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <children>
                                    <TextField fx:id="incomeAmountField" prefWidth="150.0" />
                                    <Label fx:id="incomeCurrencyLabel" />
                                 </children>
                              </HBox>
                           </children>
                        </GridPane>
                     </content>
                  </Tab>
                  <Tab fx:id="expenseTab" text="Расход">
                     <content>
                        <GridPane hgap="5.0" vgap="5.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="80.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                           </rowConstraints>
                           <children>
                              <Label text="Деньги" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1">
                                 <children>
                                    <Button fx:id="expenseMoneyButton" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="expenseMoneyClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="expenseMoneyLabel" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="Бюджет" GridPane.rowIndex="1" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <Button fx:id="expenseBudgetButton" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="expenseBudgetClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="expenseBudgetLabel" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="Сумма" GridPane.rowIndex="2" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <children>
                                    <TextField fx:id="expenseAmountField" prefWidth="150.0" />
                                    <Label fx:id="expenseCurrencyLabel" />
                                 </children>
                              </HBox>
                           </children>
                        </GridPane>
                     </content>
                  </Tab>
                  <Tab fx:id="transferTab" text="Перевод">
                     <content>
                        <GridPane hgap="5.0" vgap="5.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="80.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                           </rowConstraints>
                           <children>
                              <Label text="Со счёта" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1">
                                 <children>
                                    <Button fx:id="transferFromButton" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="transferFromClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="transferFromLabel" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="На счёт" GridPane.rowIndex="1" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <Button fx:id="transferToButton" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="transferToClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="transferToLabel" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="Сумма" GridPane.rowIndex="2" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <children>
                                    <TextField fx:id="transferAmountField" prefWidth="150.0" />
                                    <Label fx:id="transferCurrencyLabel" />
                                 </children>
                              </HBox>
                           </children>
                        </GridPane>
                     </content>
                  </Tab>
                  <Tab fx:id="exchangeTab" text="Обмен валюты">
                     <content>
                        <GridPane hgap="5.0" vgap="5.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="80.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                              <RowConstraints vgrow="NEVER" />
                           </rowConstraints>
                           <children>
                              <Label text="Отдаём" style="-fx-font-weight: bold;" GridPane.columnIndex="1" />
                              <Label text="Деньги" GridPane.rowIndex="1" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <Button fx:id="exchangeMoney1Button" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="exchangeMoney1ClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="exchangeMoney1Label" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="Бюджет" GridPane.rowIndex="2" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <children>
                                    <Button fx:id="exchangeBudget1Button" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="exchangeBudget1ClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="exchangeBudget1Label" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="Сумма" GridPane.rowIndex="3" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                 <children>
                                    <TextField fx:id="exchangeAmount1Field" prefWidth="150.0" />
                                    <Label fx:id="exchangeCurrency1Label" />
                                 </children>
                              </HBox>
                              <Label text="Получаем" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                              <Label text="Деньги" GridPane.rowIndex="5" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                                 <children>
                                    <Button fx:id="exchangeMoney2Button" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="exchangeMoney2ClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="exchangeMoney2Label" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="Бюджет" GridPane.rowIndex="6" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                                 <children>
                                    <Button fx:id="exchangeBudget2Button" mnemonicParsing="false" text="Выбрать..." />
                                    <Button fx:id="exchangeBudget2ClearButton" mnemonicParsing="false" text="✕" />
                                    <Label fx:id="exchangeBudget2Label" text="(не выбран)" />
                                 </children>
                              </HBox>
                              <Label text="Сумма" GridPane.rowIndex="7" />
                              <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
                                 <children>
                                    <TextField fx:id="exchangeAmount2Field" prefWidth="150.0" />
                                    <Label fx:id="exchangeCurrency2Label" />
                                 </children>
                              </HBox>
                              <Label fx:id="exchangeRateLabel" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                           </children>
                        </GridPane>
                     </content>
                  </Tab>
                  <Tab fx:id="detailsTab" text="Детали">
                     <content>
                        <VBox spacing="5.0">
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                           <children>
                              <Label text="Строки (двойной клик по счёту - выбор)" />
                              <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                  <TableColumn fx:id="itemAccountColumn" prefWidth="160.0" text="Счёт" />
                                  <TableColumn fx:id="itemCurrencyColumn" editable="false" prefWidth="70.0" text="Валюта" />
                                  <TableColumn fx:id="itemKindColumn" editable="false" prefWidth="70.0" text="Тип" />
                                  <TableColumn fx:id="itemAmountColumn" prefWidth="110.0" text="Сумма" />
                                  <TableColumn fx:id="itemBalanceColumn" editable="false" prefWidth="110.0" text="Остаток счёта" />
                                  <TableColumn fx:id="itemDescriptionColumn" prefWidth="200.0" text="Описание" />
                                  <TableColumn fx:id="itemFlagColumn" prefWidth="60.0" text="Флаг" />
                                  <TableColumn fx:id="itemReservedUntilColumn" prefWidth="110.0" text="Резерв до" />
                                </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <HBox spacing="5.0">
                                 <children>
                                    <Button fx:id="addItemButton" mnemonicParsing="false" text="Добавить строку" />
                                    <Button fx:id="removeItemButton" mnemonicParsing="false" text="Удалить строку" />
                                 </children>
                              </HBox>
                              <Label fx:id="balanceLabel" wrapText="true" />
                           </children>
                        </VBox>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
      </VBox>
      <ButtonBar>
        <buttons>
          <Button fx:id="okButton" mnemonicParsing="false" text="Сохранить">
            <tooltip><Tooltip text="Сохранить (Shift+Enter)" /></tooltip>
          </Button>
          <Button fx:id="copyButton" mnemonicParsing="false" prefHeight="26.0" prefWidth="210.0" text="Скопировать">
            <tooltip><Tooltip text="Скопировать / Сохранить и скопировать (Ctrl+Shift+Enter)" /></tooltip>
          </Button>
          <Button fx:id="cancelButton" mnemonicParsing="false" text="Отмена">
            <tooltip><Tooltip text="Отмена (Esc)" /></tooltip>
          </Button>
        </buttons>
      </ButtonBar>
   </children>
</VBox>
