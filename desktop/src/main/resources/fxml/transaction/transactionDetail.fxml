                        <Label text="Дата" />
                        <Label text="Со счёта" GridPane.rowIndex="1" />
                        <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <SearchableComboBox fx:id="transferFromCombo" prefWidth="330.0" visibleRowCount="20" />
                              <Button fx:id="transferFromButton" mnemonicParsing="false" text="..." />
                              <Button fx:id="transferFromClearButton" mnemonicParsing="false" text="✕" />
