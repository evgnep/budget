                           <children>
                              <TextField fx:id="exchangeAmount1Field" prefWidth="150.0" />
                              <Label fx:id="exchangeCurrency1Label" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="8.0" GridPane.columnSpan="2" GridPane.halignment="LEFT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="6">
