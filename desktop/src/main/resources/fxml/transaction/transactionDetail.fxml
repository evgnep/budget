                        <Label text="Деньги" GridPane.rowIndex="1" />
                        <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <SearchableComboBox fx:id="expenseMoneyCombo" prefWidth="330.0" visibleRowCount="20" />
                              <Button fx:id="expenseMoneyButton" mnemonicParsing="false" text="..." />
                              <Button fx:id="expenseMoneyClearButton" mnemonicParsing="false" text="✕" />
