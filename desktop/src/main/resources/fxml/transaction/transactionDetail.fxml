                        </HBox>
                        <Label text="Деньги" GridPane.rowIndex="3" />
                        <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                           <children>
                              <SearchableComboBox fx:id="exchangeMoney1Combo" prefWidth="330.0" visibleRowCount="20" />
                              <Button fx:id="exchangeMoney1Button" mnemonicParsing="false" text="..." />
                              <Button fx:id="exchangeMoney1ClearButton" mnemonicParsing="false" text="✕" />
                           </children>
                        </HBox>
                        <Label text="Бюджет" GridPane.rowIndex="4" />
                        <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
