                        <Button fx:id="swapAccountsButton" mnemonicParsing="false" styleClass="swap-accounts-button" text="⇄ Поменять счета местами" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="На счёт" GridPane.rowIndex="3" />
