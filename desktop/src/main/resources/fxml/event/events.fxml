<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="640.0" prefWidth="1100.0" spacing="5.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="su.nepom.budget.desktop.ui.event.EventsController">
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <children>
      <BorderPane>
         <center>
            <FlowPane hgap="10.0" vgap="6.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Место" />
                        <TextField fx:id="placeFilterField" prefWidth="90.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Номер" />
                        <TextField fx:id="noFromField" prefWidth="70.0" />
                        <Label text="-" />
                        <TextField fx:id="noToField" prefWidth="70.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Период" />
                        <ComboBox fx:id="dateRangeComboBox" />
                        <Label fx:id="periodHintLabel" style="-fx-text-fill: #8b95a2; -fx-font-family: monospace;" />
                     </children>
                  </HBox>
                  <HBox fx:id="customDateBox" alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="с" />
                        <DatePicker fx:id="fromDatePicker" prefWidth="180.0" />
                        <Label text="по" />
                        <DatePicker fx:id="toDatePicker" prefWidth="180.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Автор" />
                        <TextField fx:id="creatorFilterField" prefWidth="110.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Тип" />
                        <ComboBox fx:id="typeFilterComboBox" prefWidth="120.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Вид объекта" />
                        <ComboBox fx:id="kindFilterComboBox" prefWidth="130.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="Содержит" />
                        <TextField fx:id="contentPartFilterField" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label text="UID объекта" />
                        <TextField fx:id="uidFilterField" prefWidth="260.0" />
                     </children>
                  </HBox>
                  <Hyperlink fx:id="resetFilterButton" text="Сбросить все" />
               </children>
            </FlowPane>
         </center>
      </BorderPane>
      <SplitPane dividerPositions="0.55" VBox.vgrow="ALWAYS">
         <items>
            <VBox spacing="5.0">
               <children>
                  <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="dateColumn" editable="false" prefWidth="140.0" text="Дата" />
                      <TableColumn fx:id="creatorColumn" editable="false" prefWidth="120.0" text="Автор" />
                      <TableColumn fx:id="placeColumn" editable="false" prefWidth="90.0" text="Место" />
                      <TableColumn fx:id="noColumn" editable="false" prefWidth="70.0" text="Номер" />
                      <TableColumn fx:id="typeColumn" editable="false" prefWidth="100.0" text="Тип" />
                      <TableColumn fx:id="kindColumn" editable="false" prefWidth="120.0" text="Вид объекта" />
                      <TableColumn fx:id="uidColumn" editable="false" prefWidth="200.0" text="UID объекта" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox alignment="CENTER_LEFT" spacing="5.0">
                     <children>
                        <Label fx:id="rangeLabel" style="-fx-text-fill: #7c8593; -fx-font-family: monospace;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="firstPageButton" mnemonicParsing="false" text="«" />
                        <Button fx:id="prevPageButton" mnemonicParsing="false" text="‹" />
                        <TextField fx:id="pageField" alignment="CENTER_RIGHT" prefWidth="50.0" />
                        <Label fx:id="pageCountLabel" style="-fx-font-family: monospace;" />
                        <Button fx:id="nextPageButton" mnemonicParsing="false" text="›" />
                        <Button fx:id="lastPageButton" mnemonicParsing="false" text="»" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <StackPane>
               <children>
                  <Label fx:id="placeholderLabel" text="Выберите событие" />
                  <fx:include fx:id="currencyDetail" source="../currency/currencyDetail.fxml" />
                  <fx:include fx:id="accountDetail" source="../account/accountDetail.fxml" />
                  <fx:include fx:id="transactionDetail" source="../transaction/transactionDetail.fxml" />
                  <fx:include fx:id="jsonDetail" source="../conflict/jsonDetail.fxml" />
               </children>
            </StackPane>
         </items>
      </SplitPane>
   </children>
</VBox>
