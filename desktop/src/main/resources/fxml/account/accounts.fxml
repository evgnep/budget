<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<SplitPane fx:id="accountsSplitter" dividerPositions="0.45" prefHeight="582.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="su.nepom.budget.desktop.ui.account.AccountController">
   <items>
      <GridPane hgap="5.0" vgap="5.0">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="350.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints vgrow="NEVER" />
            <RowConstraints vgrow="NEVER" />
            <RowConstraints vgrow="ALWAYS" />
         </rowConstraints>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label text="Название" />
                  <TextField fx:id="nameFilterTextField" HBox.hgrow="ALWAYS" />
                  <Label text="Валюта" />
                  <ComboBox fx:id="currencyFilterComboBox" prefWidth="120.0" />
                  <Label text="Тег" />
                  <ComboBox fx:id="tagFilterComboBox" prefWidth="120.0" />
                  <Button fx:id="resetFilterButton" mnemonicParsing="false" text="Сбросить" />
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="5.0" GridPane.rowIndex="1">
               <children>
                  <CheckBox fx:id="showHiddenCheckbox" mnemonicParsing="false" text="Показывать скрытые" />
                  <Button fx:id="historyButton" mnemonicParsing="false" text="История" />
                  <Button fx:id="createNewButton" mnemonicParsing="false" text="Создать новый" />
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
            <TableView fx:id="accountsTableView" GridPane.rowIndex="2">
              <columns>
                <TableColumn fx:id="nameColumn" editable="false" prefWidth="150.0" text="Название" />
                <TableColumn fx:id="currencyColumn" editable="false" prefWidth="90.0" text="Валюта" />
                  <TableColumn fx:id="kindColumn" editable="false" prefWidth="90.0" text="Тип" />
                  <TableColumn fx:id="groupColumn" editable="false" prefWidth="120.0" text="Группа" />
                  <TableColumn fx:id="hiddenColumn" editable="false" prefWidth="75.0" text="Скрыт" />
                  <TableColumn fx:id="orderNoColumn" editable="false" prefWidth="75.0" text="Порядок" />
                  <TableColumn fx:id="tagsColumn" editable="false" prefWidth="120.0" text="Теги" />
              </columns>
            </TableView>
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </GridPane>
      <fx:include fx:id="accountDetail" source="accountDetail.fxml" />
   </items>
</SplitPane>
