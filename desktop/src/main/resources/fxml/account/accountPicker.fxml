<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="520.0" prefWidth="720.0" spacing="5.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="su.nepom.budget.desktop.ui.transaction.AccountPickerController">
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <Label text="Поиск" />
            <TextField fx:id="nameFilterTextField" HBox.hgrow="ALWAYS" />
            <Label fx:id="currencyFilterLabel" text="Валюта" />
            <ComboBox fx:id="currencyFilterComboBox" prefWidth="110.0" />
            <Label text="Тег" />
            <ComboBox fx:id="tagFilterComboBox" prefWidth="110.0" />
            <CheckBox fx:id="showHiddenCheckbox" mnemonicParsing="false" text="Скрытые" />
            <Button fx:id="resetFilterButton" mnemonicParsing="false" text="Сбросить" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <Button fx:id="selectAllButton" mnemonicParsing="false" text="Выбрать всё" />
            <Button fx:id="clearAllButton" mnemonicParsing="false" text="Снять всё" />
            <Label fx:id="countLabel" />
         </children>
      </HBox>
      <TableView fx:id="accountsTableView" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="selectedColumn" prefWidth="40.0" text="" />
          <TableColumn fx:id="nameColumn" editable="false" prefWidth="180.0" text="Название" />
          <TableColumn fx:id="currencyColumn" editable="false" prefWidth="90.0" text="Валюта" />
          <TableColumn fx:id="kindColumn" editable="false" prefWidth="80.0" text="Тип" />
          <TableColumn fx:id="tagsColumn" editable="false" prefWidth="150.0" text="Теги" />
          <TableColumn fx:id="descriptionColumn" editable="false" prefWidth="220.0" text="Описание" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <ButtonBar>
        <buttons>
          <Button fx:id="okButton" defaultButton="true" mnemonicParsing="false" text="ОК" />
          <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" text="Отмена" />
        </buttons>
      </ButtonBar>
   </children>
</VBox>
