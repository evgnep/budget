<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="su.nepom.budget.desktop.ui.conflict.JsonDetailController">
   <center>
      <TextArea fx:id="contentTextArea" style="-fx-font-family: monospace;" BorderPane.alignment="CENTER" />
   </center>
   <bottom>
      <ButtonBar BorderPane.alignment="CENTER">
        <buttons>
          <Button fx:id="okButton" mnemonicParsing="false" text="Сохранить" />
            <Button fx:id="cancelButton" mnemonicParsing="false" text="Отмена" />
        </buttons>
         <padding>
            <Insets top="10.0" />
         </padding>
      </ButtonBar>
   </bottom>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</BorderPane>
