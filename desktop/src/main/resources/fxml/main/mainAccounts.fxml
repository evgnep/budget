<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="5.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="su.nepom.budget.desktop.ui.main.MainAccountsController">
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <children>
      <TableView fx:id="accountsTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="nameColumn" editable="false" prefWidth="220.0" text="Название" />
          <TableColumn fx:id="kindColumn" editable="false" prefWidth="90.0" text="Тип" />
          <TableColumn fx:id="currencyColumn" editable="false" prefWidth="100.0" text="Валюта" />
          <TableColumn fx:id="restColumn" editable="false" prefWidth="140.0" text="Остаток" />
          <TableColumn fx:id="dailyBalanceColumn" editable="false" prefWidth="140.0" text="Остаток на день" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
