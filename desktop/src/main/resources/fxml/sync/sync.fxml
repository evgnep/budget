<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="su.nepom.budget.desktop.ui.sync.SyncController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Ещё не сохранённые события:" />
            <Label fx:id="unsavedLabel" text="0" />
            <Button fx:id="saveNowButton" mnemonicParsing="false" text="Сохранить сейчас" />
         </children>
      </HBox>
      <Separator />
      <Label style="-fx-font-weight: bold;" text="Хранилище событий" />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Источник:" />
            <Label fx:id="sourceLabel" />
         </children>
      </HBox>
      <TableView fx:id="placesTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="placeColumn" editable="false" prefWidth="200.0" text="Место" />
          <TableColumn fx:id="onDiskColumn" editable="false" prefWidth="140.0" text="На диске" />
          <TableColumn fx:id="importedColumn" editable="false" prefWidth="140.0" text="Импортировано" />
        </columns>
      </TableView>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button fx:id="syncButton" mnemonicParsing="false" text="Загрузить в БД" />
            <Label fx:id="progressLabel" managed="false" style="-fx-font-weight: bold;" text="ИДЁТ СИНХРОНИЗАЦИЯ..." visible="false" />
         </children>
      </HBox>
      <Separator />
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Последняя синхронизация:" />
            <Label fx:id="lastSyncLabel" text="-" />
         </children>
      </HBox>
   </children>
</VBox>
